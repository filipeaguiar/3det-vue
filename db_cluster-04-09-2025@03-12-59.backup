   FROM public.campaigns
  WHERE ((campaigns.id = sessions.campaign_id) AND (campaigns.user_id = auth.uid())))));


--
-- Name: campaigns Users can delete their own campaigns.; Type: POLICY; Schema: public; Owner: postgres
