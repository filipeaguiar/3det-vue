--
-- Name: campaigns Users can create campaigns for themselves.; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can create campaigns for themselves." ON public.campaigns FOR INSERT WITH CHECK ((auth.uid() = user_id));


--
-- Name: campaign_chapters Users can delete chapters from their campaigns.; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can delete chapters from their campaigns." ON public.campaign_chapters FOR DELETE USING ((EXISTS ( SELECT 1
   FROM public.campaigns
  WHERE ((campaigns.id = campaign_chapters.campaign_id) AND (campaigns.user_id = auth.uid())))));


--
-- Name: personagens Users can delete characters from their campaigns.; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can delete characters from their campaigns." ON public.personagens FOR DELETE USING ((EXISTS ( SELECT 1
   FROM public.campaigns
  WHERE ((campaigns.id = personagens.campaign_id) AND (campaigns.user_id = auth.uid())))));


