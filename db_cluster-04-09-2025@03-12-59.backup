   FROM public.campaigns
  WHERE ((campaigns.id = monstros.campaign_id) AND (campaigns.user_id = auth.uid())))));


--
-- Name: npcs Users can delete npcs from their campaigns.; Type: POLICY; Schema: public; Owner: postgres
